# AI Platform — example environment (NO real secrets)
# Copy to .env for local host development. Never commit .env.

# --- REQUIRED for hosted API authentication (SECRET-ish: treat as sensitive) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# --- REQUIRED for durable intelligence case storage on hosted deployments (SECRET — server-side only) ---
# Vercel/hosted production: set INTEL_CASE_STORE=supabase
INTEL_CASE_STORE=memory
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key

# --- REQUIRED for real model calls (SECRET — server-side only) ---
# Use one of these; both are accepted by the OpenAI-compatible adapter.
OPENAI_API_KEY=sk-...
# XAI_API_KEY=xai-...

# --- OPTIONAL provider routing ---
# Default: https://api.openai.com/v1
# For xAI/Grok: https://api.x.ai/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# --- OPTIONAL host tuning ---
AI_PLATFORM_PROVIDER=openai-compatible
AI_PLATFORM_PROVIDER_TIMEOUT_SECONDS=60

# --- OPTIONAL claim names (defaults match Custom Access Token Hook) ---
AI_PLATFORM_TENANT_CLAIM=ai_platform_tenant_id
AI_PLATFORM_PERMISSIONS_CLAIM=ai_platform_permissions

# --- DEVELOPMENT ONLY ---
# Enables the server-gated mock Case Workspace at /app/cases/demo.
# Never enable this in Vercel Production; the application rejects demo mode
# whenever VERCEL_ENV or ENVIRONMENT is set to production.
AI_PLATFORM_DEMO_MODE=false
