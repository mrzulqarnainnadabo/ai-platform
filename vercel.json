{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "ai_platform/**",
          "api/**",
          "requirements.txt"
        ]
      }
    },
    {
      "src": "api/frontdoor.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "10mb",
        "includeFiles": [
          "api/frontdoor.py"
        ]
      }
    }
  ],
  "routes": [
    { "src": "^/$", "status": 307, "headers": { "Location": "/app/cases" } },
    { "src": "^/app/?$", "dest": "api/frontdoor.py" },
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
