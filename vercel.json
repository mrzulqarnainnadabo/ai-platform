{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": ["config/models.yaml"],
      "excludeFiles": "{tests/**,docs/**,.git/**,third_party/**,**/__pycache__/**,**/*.pyc,**/.pytest_cache/**,**/.mypy_cache/**,**/.ruff_cache/**,**/node_modules/**,**/*.bin,**/*.safetensors,**/*.pt,**/*.pth}"
    },
    "api/frontdoor.py": {
      "excludeFiles": "{tests/**,docs/**,.git/**,third_party/**,**/__pycache__/**,**/*.pyc,**/.pytest_cache/**,**/.mypy_cache/**,**/.ruff_cache/**,**/node_modules/**,**/*.bin,**/*.safetensors,**/*.pt,**/*.pth}"
    }
  },
  "routes": [
    { "src": "^/$", "status": 307, "headers": { "Location": "/app/cases" } },
    { "src": "^/app/?$", "dest": "api/frontdoor.py" },
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
